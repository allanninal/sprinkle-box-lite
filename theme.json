{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "48rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "bg",
					"color": "#FFF8F0",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#FFFFFF",
					"name": "Surface"
				},
				{
					"slug": "surface-2",
					"color": "#FFF0E4",
					"name": "Surface 2"
				},
				{
					"slug": "surface-3",
					"color": "#FFE4CC",
					"name": "Surface 3"
				},
				{
					"slug": "border-base",
					"color": "#F0D5C0",
					"name": "Border"
				},
				{
					"slug": "border-light",
					"color": "#F8EDE3",
					"name": "Border (light)"
				},
				{
					"slug": "text-strong",
					"color": "#1A0A0F",
					"name": "Text (strong)"
				},
				{
					"slug": "text-body",
					"color": "#2D1020",
					"name": "Body text"
				},
				{
					"slug": "text-muted",
					"color": "#4D2035",
					"name": "Muted text"
				},
				{
					"slug": "text-subtle",
					"color": "#6B3A50",
					"name": "Subtle text"
				},
				{
					"slug": "accent",
					"color": "#B81D4F",
					"name": "Accent"
				},
				{
					"slug": "accent-dark",
					"color": "#8C1038",
					"name": "Accent dark"
				},
				{
					"slug": "accent-light",
					"color": "#D6265B",
					"name": "Accent light"
				},
				{
					"slug": "accent-pale",
					"color": "#FFE4EE",
					"name": "Accent pale"
				},
				{
					"slug": "accent-hover",
					"color": "#8C1038",
					"name": "Accent hover"
				},
				{
					"slug": "accent-bg",
					"color": "#FFF0F5",
					"name": "Accent bg"
				},
				{
					"slug": "sky",
					"color": "#0E7AC4",
					"name": "Sky"
				},
				{
					"slug": "sky-dark",
					"color": "#095E99",
					"name": "Sky dark"
				},
				{
					"slug": "sky-light",
					"color": "#1E9AE0",
					"name": "Sky light"
				},
				{
					"slug": "sky-pale",
					"color": "#E0F2FF",
					"name": "Sky pale"
				},
				{
					"slug": "sky-bg",
					"color": "#F0F8FF",
					"name": "Sky bg"
				},
				{
					"slug": "yellow",
					"color": "#F5C842",
					"name": "Yellow"
				},
				{
					"slug": "mint",
					"color": "#4ABFA0",
					"name": "Mint"
				},
				{
					"slug": "purple",
					"color": "#9B6FD4",
					"name": "Purple"
				},
				{
					"slug": "dark-bg",
					"color": "#1A0A0F",
					"name": "Dark bg"
				},
				{
					"slug": "dark-surface",
					"color": "#2D1020",
					"name": "Dark surface"
				},
				{
					"slug": "dark-text",
					"color": "#FFF8F0",
					"name": "Dark text"
				},
				{
					"slug": "dark-muted",
					"color": "#D4A8B8",
					"name": "Dark muted"
				},
				{
					"slug": "dark-border",
					"color": "#4D2035",
					"name": "Dark border"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Fredoka",
					"slug": "display",
					"fontFamily": "\"Fredoka\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Fredoka",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fredoka-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Fredoka",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fredoka-latin-500-normal.woff2"
							]
						},
						{
							"fontFamily": "Fredoka",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fredoka-latin-600-normal.woff2"
							]
						}
					]
				},
				{
					"name": "Nunito Sans",
					"slug": "body",
					"fontFamily": "\"Nunito Sans\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Nunito Sans",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunito-sans-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Nunito Sans",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunito-sans-latin-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Nunito Sans",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunito-sans-latin-700-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3rem"
					}
				},
				{
					"slug": "huge",
					"name": "Display",
					"size": "4.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text-body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4vw, 2.5rem)",
				"right": "clamp(1.25rem, 4vw, 2.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--text-strong)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-dark)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--bg)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "0.02em"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-dark)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"width": "2px",
							"color": "var(--wp--preset--color--accent)"
						},
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--accent-dark)"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.5rem",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--text-strong)"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [],
	"title": "Sprinkle Box"
}
